# Copy to .env.local.
# Where the judge listens. WSL: http://localhost:4000. Multipass: http://<VM IP>:4000.
JUDGE_SERVICE_URL=http://localhost:4000
# Printed by judge/scripts/setup-ubuntu.sh (also in /etc/exeku-judge.env on the judge machine).
JUDGE_TOKEN=
# Set to 1 only behind Vercel or a proxy that overwrites x-forwarded-for. It lets the run limit see real network addresses.
# TRUST_PROXY=1
